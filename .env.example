# debug important things
DEBUG=wabot:*:error,wabot:*:warn,wabot:*:info

# using postgres db
DATABASE_URL=

# using AI providers (one or multiple)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# signs the session cookie — required, the app refuses to boot without it
JWT_SECRET=

# session lifetime in seconds; the framework default is 600 (10 min), unusable for a work day
JWT_ACCESS_EXPIRATION_SECONDS=43200

# the single operator allowed to sign in
AUTH_EMAIL=
AUTH_PASSWORD=

# true when serving over HTTPS, so the session cookie never travels in the clear
AUTH_COOKIE_SECURE=false

# opcional: origen de catálogo EXTERNO para rellenar líneas de factura.
# Con esta variable puesta manda el externo y el catálogo local queda INVISIBLE:
# nunca hay dos orígenes a la vez, porque dos pueden devolver la misma `ref` para
# cosas distintas y siendo opaca nadie podría desambiguarlas sin partirla.
# Sin esta variable sirve el catálogo local (los artículos de Inventario); y sin
# ninguno de los dos no hay buscador y la aplicación funciona entera: escribir las
# líneas a mano es el camino normal, no un modo degradado.
# Quien la implemente tiene que servir dos rutas:
#   GET {CATALOG_URL}/v1/items?q=texto   -> [ { ref, code, label, unitPrice, taxRate } ]
#   GET {CATALOG_URL}/v1/items/{ref}     -> { ref, code, label, unitPrice, taxRate }
# `ref` es opaco: facturación lo guarda y lo devuelve, nunca lo interpreta.
# Los campos que no estén declarados se ignoran; un elemento sin ref, sin label o sin
# unitPrice se descarta; taxRate ausente cuenta como cero.
CATALOG_URL=
